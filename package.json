{
	"name": "ugovor",
	"private": true,
	"type": "module",
	"version": "0.1.1",
	"packageManager": "pnpm@10.23.0",
	"scripts": {
		"dev": "nuxt dev",
		"pwa": "pnpm run generate && npx serve .output/public  ",
		"build": "pnpm run sync-version && nuxt build",
		"start": "nuxt start",
		"generate": "pnpm run sync-version && nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"format": "prettier --write .",
		"sync-version": "node -e \"const fs = require('fs'); const pkg = require('./package.json'); fs.writeFileSync('public/version.json', JSON.stringify({ version: pkg.version }, null, 2));\""
	},
	"dependencies": {
		"@heroicons/vue": "^2.2.0",
		"@nuxt/fonts": "^0.11.3",
		"@nuxt/icon": "^1.12.0",
		"@nuxt/image": "^1.10.0",
		"@nuxtjs/supabase": "^2.0.1",
		"@pinia/nuxt": "^0.11.2",
		"@vueuse/core": "^14.0.0",
		"date-fns": "^4.1.0",
		"echarts": "^6.0.0",
		"naive-ui": "^2.41.0",
		"nuxt": "^4.3.0",
		"nuxtjs-naive-ui": "^1.0.2",
		"vue-echarts": "^8.0.1",
		"vue3-countup": "^0.0.4",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@hypernym/nuxt-anime": "^2.1.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.0",
		"@nuxt/eslint": "^1.3.1",
		"@nuxtjs/tailwindcss": "^6.12.1",
		"@types/web-push": "^3.6.4",
		"@vite-pwa/nuxt": "^1.0.4",
		"autoprefixer": "^10.4.21",
		"esbuild": "^0.28.0",
		"postcss": "^8.5.4",
		"prettier": "^3.6.2",
		"sass-embedded": "^1.89.1",
		"supabase": "^2.65.5",
		"tailwindcss": "^3.4.0",
		"vueuc": "0.3.5"
	},
	"pnpm": {
		"overrides": {
			"@nuxt/vite-builder": "4.4.5"
		},
		"onlyBuiltDependencies": [
			"supabase",
			"@parcel/watcher",
			"esbuild",
			"sharp"
		]
	}
}
