    "@pinia/nuxt": "^0.11.2",
    "eslint": "^9.26.0",
    "naive-ui": "^2.41.0",
    "nuxt": "^3.17.3",
    "nuxtjs-naive-ui": "^1.0.2",
    "serve": "^14.2.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@css-render/vue3-ssr": "^0.15.14",
